<Window x:Class="The_Movies.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:The_Movies"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1200
        ">
    <Grid RenderTransformOrigin="0.472,0.478" Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="67*"/>
            <ColumnDefinition Width="733*"/>
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="2" HorizontalAlignment="Left" Height="20" Margin="372,63,0,0" TextWrapping="Wrap" Text="{Binding Title}" VerticalAlignment="Top" Width="168"/>
        <TextBlock x:Name="sadasd1" Grid.Column="2" HorizontalAlignment="Left" Margin="334,64,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="30" Height="16"><Run Text="Titel"/><Run Language="da-dk" Text=":"/></TextBlock>
        <TextBox Grid.Column="2" HorizontalAlignment="Left" Height="20" Margin="372,107,0,0" TextWrapping="Wrap" Text="{Binding Length}" VerticalAlignment="Top" Width="168"/>
        <TextBlock x:Name="sadasd_Copy2" Grid.Column="2" HorizontalAlignment="Left" Margin="256,106,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="112" Height="20"><Run Text="Varighed"/><Run Text=" "/><Run Language="da-dk" Text="i munitter"/><Run Text=":"/></TextBlock>
        <TextBlock x:Name="sadasd_Copy3" Grid.Column="2" HorizontalAlignment="Left" Margin="328,150,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="36" Text="Genre:" Height="16"/>
        <ComboBox Grid.Column="2"
          HorizontalAlignment="Left"
          Margin="372,148,0,0"
          Width="168"
          VerticalAlignment="Top"
          SelectedValue="{Binding Genre, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Height="22">


            <ComboBoxItem Content="Action"/>
            <ComboBoxItem Content="Adventure"/>
            <ComboBoxItem Content="Comedy"/>
            <ComboBoxItem Content="Science fiction"/>
            <ComboBoxItem Content="Crime"/>
            <ComboBoxItem Content="Romance"/>
            <ComboBoxItem Content="Musical"/>
            <ComboBoxItem Content="History"/>
            <ComboBoxItem Content="Dokumentar"/>
            <ComboBoxItem Content="Drama"/>
            <ComboBoxItem Content="Fantasy"/>
            <ComboBoxItem Content="Horror"/>
            <ComboBoxItem Content="Western"/>
            <ComboBoxItem Content="Thriller"/>

        </ComboBox>


        <Button Grid.Column="2" Content="Tilføj Film" HorizontalAlignment="Left" Margin="392,182,0,0" VerticalAlignment="Top" Height="19" Width="116" Command="{Binding AddMovieCommand}"/>


        <Button Grid.Column="2" Content="Slet Film" HorizontalAlignment="Left" Margin="392,206,0,0" VerticalAlignment="Top" Height="20" Width="116"  Command="{Binding RemoveMovieCommand}"/>
        <TextBlock Grid.Column="2" HorizontalAlignment="Left" Margin="400,31,0,0" TextWrapping="Wrap" Text="Opret Film" FontWeight="Bold" FontSize="20" VerticalAlignment="Top"/>
        <TextBlock Grid.Column="2" HorizontalAlignment="Left" Margin="668,31,0,0" TextWrapping="Wrap" Text="Opret forestilling" FontSize="20" FontWeight="Bold" VerticalAlignment="Top"/>
        <TextBox Grid.Column="2" HorizontalAlignment="Left" Height="20" Margin="664,63,0,0" TextWrapping="Wrap" Text="{Binding Title}" VerticalAlignment="Top" Width="168"/>
        <TextBox Grid.Column="2" HorizontalAlignment="Left" Height="20" Margin="664,108,0,0" TextWrapping="Wrap" Text="{Binding Title}" VerticalAlignment="Top" Width="168"/>
        <TextBlock Grid.Column="2" HorizontalAlignment="Left" Margin="92,31,0,0" TextWrapping="Wrap" FontSize="20" FontWeight="Bold" VerticalAlignment="Top"><Run Text="Opret "/><Run Language="da-dk" Text="b"/><Run Language="da-dk" Text="iograf"/></TextBlock>
        <TextBox Grid.Column="2" HorizontalAlignment="Left" Height="20" Margin="72,107,0,0" TextWrapping="Wrap" Text="{Binding Title}" VerticalAlignment="Top" Width="168"/>
        <TextBlock Grid.Column="2" HorizontalAlignment="Left" Margin="40,64,0,0" TextWrapping="Wrap" Text="Navn" VerticalAlignment="Top" RenderTransformOrigin="1.068,0.88"/>
        <TextBlock Grid.Column="2" HorizontalAlignment="Left" Margin="16,108,0,0" TextWrapping="Wrap" Text="Antal sale" VerticalAlignment="Top" RenderTransformOrigin="1.068,0.88"/>
        <Button Grid.Column="2" Content="Opret biograf" HorizontalAlignment="Left" Margin="92,140,0,0" VerticalAlignment="Top" Width="130" />
        <ListBox Grid.Column="2" ItemsSource="{Binding Movies}" SelectedItem="{Binding SelectedMovie}" Margin="328,231,527,101"/>
        <ListBox Grid.Column="2" ItemsSource="{Binding Movies}" SelectedItem="{Binding SelectedMovie}" Margin="34,231,821,101"/>
        <ListBox Grid.Column="2" ItemsSource="{Binding Movies}" SelectedItem="{Binding SelectedMovie}" Margin="626,231,231,101"/>
        <TextBox Grid.Column="2" HorizontalAlignment="Left" Height="20" Margin="72,64,0,0" TextWrapping="Wrap" Text="{Binding Title}" VerticalAlignment="Top" Width="168"/>

    </Grid>
</Window>
