<Window x:Class="The_Movies.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:The_Movies" 
        xmlns:viewmodel="clr-namespace:The_Movies.ViewModel" 
        d:DataContext="{d:DesignInstance Type=viewmodel:MainViewModel}"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1200">

    <Grid RenderTransformOrigin="0.472,0.478" Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="67*"/>
            <ColumnDefinition Width="733*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= OPRET FILM ================= -->
        <TextBlock Grid.Column="2" HorizontalAlignment="Left" Margin="400,31,0,0" TextWrapping="Wrap" Text="Opret Film" FontWeight="Bold" FontSize="20" VerticalAlignment="Top"/>

        <TextBlock Grid.Column="2" HorizontalAlignment="Left" Margin="334,64,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="30" Height="16">
            <Run Text="Titel"/><Run Language="da-dk" Text=":"/>
        </TextBlock>
        <TextBox Grid.Column="2" HorizontalAlignment="Left" Height="20" Margin="372,63,0,0" TextWrapping="Wrap" Text="{Binding Movie.Title}" VerticalAlignment="Top" Width="168"/>

        <TextBlock Grid.Column="2" HorizontalAlignment="Left" Margin="264,108,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="128" Height="20">
            <Run Text="Varighed"/><Run Text=" "/><Run Text="i m"/><Run Text="in"/><Run Text="utter"/><Run Text=":"/>
        </TextBlock>
        <TextBox Grid.Column="2" HorizontalAlignment="Left" Height="20" Margin="372,107,0,0" TextWrapping="Wrap" Text="{Binding Movie.Length}" VerticalAlignment="Top" Width="168"/>

        <TextBlock Grid.Column="2" HorizontalAlignment="Left" Margin="310,146,0,0" TextWrapping="Wrap" Text="Instruktør:" VerticalAlignment="Top"/>
        <TextBox Grid.Column="2" HorizontalAlignment="Left" Height="20" Margin="372,144,0,0" TextWrapping="Wrap" Text="{Binding Movie.Director}" VerticalAlignment="Top" Width="168"/>

        <TextBlock Grid.Column="2" HorizontalAlignment="Left" Margin="286,177,0,0" TextWrapping="Wrap" Text="Premiere dato:" VerticalAlignment="Top"/>
        <DatePicker Grid.Column="2" HorizontalAlignment="Left" Margin="392,173,0,0" VerticalAlignment="Top" SelectedDate="{Binding Movie.ReleaseDate}"/>

        <TextBlock Grid.Column="2" HorizontalAlignment="Left" Margin="328,217,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="36" Text="Genre:" Height="16"/>
        <ComboBox Grid.Column="2" HorizontalAlignment="Left" Margin="372,215,0,0" Width="168" VerticalAlignment="Top" SelectedValue="{Binding Movie.Genre, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Height="22">
            <ComboBoxItem Content="Action"/>
            <ComboBoxItem Content="Adventure"/>
            <ComboBoxItem Content="Comedy"/>
            <ComboBoxItem Content="Science fiction"/>
            <ComboBoxItem Content="Crime"/>
            <ComboBoxItem Content="Romance"/>
            <ComboBoxItem Content="Musical"/>
            <ComboBoxItem Content="History"/>
            <ComboBoxItem Content="Dokumentar"/>
            <ComboBoxItem Content="Drama"/>
            <ComboBoxItem Content="Fantasy"/>
            <ComboBoxItem Content="Horror"/>
            <ComboBoxItem Content="Western"/>
            <ComboBoxItem Content="Thriller"/>
        </ComboBox>

        <Button Grid.Column="2" Content="Tilføj Film" HorizontalAlignment="Left" Margin="392,251,0,0" VerticalAlignment="Top" Height="19" Width="116" Command="{Binding Movie.AddMovieCommand}"/>
        <Button Grid.Column="2" Content="Slet Film" HorizontalAlignment="Left" Margin="392,280,0,0" VerticalAlignment="Top" Height="20" Width="116" Command="{Binding Movie.RemoveMovieCommand}"/>
        <ListBox Grid.Column="2" ItemsSource="{Binding Movie.Movies}" SelectedItem="{Binding Movie.SelectedMovie}" Margin="346,331,509,29"/>

        
        <!-- ================= OPRET BIOGRAF ================= -->

        <TextBlock Grid.Column="2"
           HorizontalAlignment="Left"
           Margin="92,31,0,0"
           Text="Opret biograf"
           FontSize="20"
           FontWeight="Bold"
           VerticalAlignment="Top"/>

        <TextBlock Grid.Column="2"
           HorizontalAlignment="Left"
           Margin="40,64,0,0"
           Text="Navn"
           VerticalAlignment="Top"/>

        <TextBox Grid.Column="2"
         HorizontalAlignment="Left"
         Height="20"
         Margin="72,64,0,0"
         Text="{Binding Cinema.Name}"
         VerticalAlignment="Top"
         Width="168"/>

        <Button Grid.Column="2"
        Content="Tilføj biograf"
        HorizontalAlignment="Left"
        Margin="98,176,0,0"
        VerticalAlignment="Top"
        Height="19"
        Width="116"
        Command="{Binding Cinema.AddCinemaCommand}"/>

        <Button Grid.Column="2"
        Content="Slet biograf"
        HorizontalAlignment="Left"
        Margin="98,200,0,0"
        VerticalAlignment="Top"
        Height="20"
        Width="116"
        Command="{Binding Cinema.RemoveCinemaCommand}"/>

        <ListBox Grid.Column="2"
         ItemsSource="{Binding Cinema.Cinemas}"
         SelectedItem="{Binding Cinema.SelectedCinema}"
         Margin="28,244,803,28"/>
        
        <!-- ================= TILFØJ SAL TIL BIOGRAF ================= -->

        <TextBlock Grid.Column="2"
           HorizontalAlignment="Left"
           Margin="14,100,0,0"
           Text="Antal sale:"
           VerticalAlignment="Top"/>

        <ComboBox Grid.Column="2"
          HorizontalAlignment="Left"
          Margin="72,97,0,0"
          VerticalAlignment="Top"
          Width="168"
          SelectedValue="{Binding Cinema.SelectedNumberOfSale}"
          SelectedValuePath="Content">

            <ComboBoxItem Content="1"/>
            <ComboBoxItem Content="2"/>
            <ComboBoxItem Content="3"/>
            <ComboBoxItem Content="4"/>
            <ComboBoxItem Content="5"/>
            <ComboBoxItem Content="6"/>
            <ComboBoxItem Content="7"/>
            <ComboBoxItem Content="8"/>
            <ComboBoxItem Content="9"/>
            <ComboBoxItem Content="10"/>
            <ComboBoxItem Content="11"/>
            <ComboBoxItem Content="12"/>
            <ComboBoxItem Content="13"/>
            <ComboBoxItem Content="14"/>
            <ComboBoxItem Content="15"/>
            <ComboBoxItem Content="16"/>
            <ComboBoxItem Content="17"/>

        </ComboBox>

        <!-- ================= OPRET FORESTILLING ================= -->
        <TextBlock Grid.Column="2"
           HorizontalAlignment="Left"
           Margin="668,31,0,0"
           Text="Opret forestilling"
           FontSize="20"
           FontWeight="Bold"
           VerticalAlignment="Top"/>


        <!-- Vælg film -->

        <TextBlock Grid.Column="2"
           HorizontalAlignment="Left"
           Margin="598,75,0,0"
           Text="Vælg Film:"
           VerticalAlignment="Top"/>

        <ComboBox Grid.Column="2"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          Margin="674,72,0,0"
          Width="168"
          Height="22"
          ItemsSource="{Binding Movie.Movies}"
          DisplayMemberPath="Title"
          SelectedItem="{Binding Movie.SelectedMovie}"/>


        <!-- Vælg biograf -->

        <TextBlock Grid.Column="2"
           HorizontalAlignment="Left"
           Margin="580,111,0,0"
           Text="Vælg Biograf:"
           VerticalAlignment="Top"/>

        <ComboBox Grid.Column="2"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          Margin="674,108,0,0"
          Width="168"
          Height="22"
          ItemsSource="{Binding Cinema.Cinemas}"
          DisplayMemberPath="Name"
          SelectedItem="{Binding Cinema.SelectedCinema}"/>


        <!-- Vælg sal -->

        <TextBlock Grid.Column="2"
           HorizontalAlignment="Left"
           Margin="604,147,0,0"
           Text="Vælg Sal:"
           VerticalAlignment="Top"/>

        <ComboBox Grid.Column="2"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          Margin="674,144,0,0"
          Width="168"
          Height="22"
          ItemsSource="{Binding Cinema.SelectedCinema.Sale}"
          DisplayMemberPath="Name"
          SelectedItem="{Binding Sal.SelectedSal}"/>


        <!-- Vælg starttid -->

        <TextBlock Grid.Column="2"
           HorizontalAlignment="Left"
           Margin="580,183,0,0"
           Text="Vælg Starttid:"
           VerticalAlignment="Top"/>

        <ComboBox Grid.Column="2"
          HorizontalAlignment="Left"
          Margin="674,180,0,0"
          Width="168"
          Height="22"
          VerticalAlignment="Top"
          SelectedValue="{Binding Forestilling.StartTid, UpdateSourceTrigger=PropertyChanged}"
          SelectedValuePath="Content">

            <ComboBoxItem Content="10:00:00"/>
            <ComboBoxItem Content="10:30:00"/>
            <ComboBoxItem Content="11:00:00"/>
            <ComboBoxItem Content="11:30:00"/>
            <ComboBoxItem Content="12:00:00"/>
            <ComboBoxItem Content="12:30:00"/>
            <ComboBoxItem Content="13:00:00"/>
            <ComboBoxItem Content="13:30:00"/>
            <ComboBoxItem Content="14:00:00"/>
            <ComboBoxItem Content="14:30:00"/>
            <ComboBoxItem Content="15:00:00"/>
            <ComboBoxItem Content="15:30:00"/>
            <ComboBoxItem Content="16:00:00"/>
            <ComboBoxItem Content="16:30:00"/>
            <ComboBoxItem Content="17:00:00"/>
            <ComboBoxItem Content="17:30:00"/>
            <ComboBoxItem Content="18:00:00"/>
            <ComboBoxItem Content="18:30:00"/>
            <ComboBoxItem Content="19:00:00"/>
            <ComboBoxItem Content="19:30:00"/>
            <ComboBoxItem Content="20:00:00"/>
            <ComboBoxItem Content="20:30:00"/>
            <ComboBoxItem Content="21:00:00"/>
            <ComboBoxItem Content="21:30:00"/>
            <ComboBoxItem Content="22:00:00"/>

        </ComboBox>


        <!-- Knapper -->

        <Button Grid.Column="2"
        Content="Tilføj Forestilling"
        HorizontalAlignment="Left"
        Margin="690,220,0,0"
        VerticalAlignment="Top"
        Height="19"
        Width="116"
        Command="{Binding Forestilling.AddForestillingCommand}"/>

        <Button Grid.Column="2"
        Content="Slet Forestilling"
        HorizontalAlignment="Left"
        Margin="690,248,0,0"
        VerticalAlignment="Top"
        Height="20"
        Width="116"
        Command="{Binding Forestilling.RemoveForestillingCommand}"/>


        <!-- Liste over forestillinger -->

        <ListBox Grid.Column="2"
         ItemsSource="{Binding Forestilling.Forestillinger}"
         SelectedItem="{Binding Forestilling.SelectedForestilling}"
         Margin="628,285,230,20"/>
    </Grid>
</Window>