<Window x:Class="The_Movies.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:The_Movies"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid RenderTransformOrigin="0.222,0.599">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="67*"/>
            <ColumnDefinition Width="733*"/>
        </Grid.ColumnDefinitions>
        <ListBox Grid.Column="2" ItemsSource="{Binding Movies}" SelectedItem="{Binding SelectedMovie}" Margin="319,66,41,24"/>
        <TextBox Grid.Column="2" HorizontalAlignment="Left" Height="20" Margin="134,88,0,0" TextWrapping="Wrap" Text="{Binding Title}" VerticalAlignment="Top" Width="168"/>
        <TextBlock x:Name="sadasd1" Grid.Column="2" HorizontalAlignment="Left" Margin="89,90,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="30" Height="16"><Run Text="Titel"/><Run Language="da-dk" Text=":"/></TextBlock>
        <TextBox Grid.Column="2" HorizontalAlignment="Left" Height="20" Margin="134,135,0,0" TextWrapping="Wrap" Text="{Binding Length}" VerticalAlignment="Top" Width="168" TextChanged="TextBox_TextChanged"/>
        <TextBlock x:Name="sadasd_Copy2" Grid.Column="2" HorizontalAlignment="Left" Margin="10,135,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="113" Height="20"><Run Text="Varighed"/><Run Text=" "/><Run Language="da-dk" Text="i munitter"/><Run Text=":"/></TextBlock>
        <TextBlock x:Name="sadasd_Copy3" Grid.Column="2" HorizontalAlignment="Left" Margin="83,182,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="36" Text="Genre:" Height="16"/>
        <ComboBox Grid.Column="2"
          HorizontalAlignment="Left"
          Margin="134,179,0,0"
          Width="168"
          VerticalAlignment="Top"
          SelectedValue="{Binding Genre, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Height="22">


            <ComboBoxItem Content="Action"/>
            <ComboBoxItem Content="Adventure"/>
            <ComboBoxItem Content="Comedy"/>
            <ComboBoxItem Content="Science fiction"/>
            <ComboBoxItem Content="Crime"/>
            <ComboBoxItem Content="Romance"/>
            <ComboBoxItem Content="Musical"/>
            <ComboBoxItem Content="History"/>
            <ComboBoxItem Content="Dokumentar"/>
            <ComboBoxItem Content="Drama"/>
            <ComboBoxItem Content="Fantasy"/>
            <ComboBoxItem Content="Horror"/>
            <ComboBoxItem Content="Western"/>
            <ComboBoxItem Content="Thriller"/>

        </ComboBox>


        <Button Grid.Column="2" Content="Tilføj" HorizontalAlignment="Left" Margin="19,268,0,0" VerticalAlignment="Top" Height="34" Width="116" Command="{Binding AddMovieCommand}"/>


        <Button Grid.Column="2" Content="Slet " HorizontalAlignment="Left" Margin="175,269,0,0" VerticalAlignment="Top" Height="33" Width="117"  Command="{Binding RemoveMovieCommand}"/>

    </Grid>
</Window>
