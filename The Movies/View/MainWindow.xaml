<Window x:Class="The_Movies.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:The_Movies"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid RenderTransformOrigin="0.222,0.599">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="29*"/>
            <ColumnDefinition Width="131*"/>
        </Grid.ColumnDefinitions>
        <ListBox Grid.Column="2" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="319,66,41,132"/>
        <TextBox Grid.Column="2" HorizontalAlignment="Left" Height="20" Margin="69,90,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="168"/>
        <TextBlock x:Name="sadasd1" Grid.Column="2" HorizontalAlignment="Left" Margin="34,92,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="30"><Run Text="Titel"/><Run Language="da-dk" Text=":"/></TextBlock>
        <TextBox Grid.Column="2" HorizontalAlignment="Left" Height="20" Margin="69,133,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="168"/>
        <TextBlock x:Name="sadasd_Copy2" Grid.Column="2" HorizontalAlignment="Left" Margin="10,135,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="54" Text="Varighed:"/>
        <TextBlock x:Name="sadasd_Copy3" Grid.Column="2" HorizontalAlignment="Left" Margin="19,182,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="36" Text="Genre:"/>
        <RadioButton Grid.Column="2" Content="Action&#xA;" HorizontalAlignment="Left" Margin="69,183,0,0" VerticalAlignment="Top" Checked="RadioButton_Checked"/>
        <RadioButton Grid.Column="2" Content="Adventure" HorizontalAlignment="Left" Margin="69,205,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.563,2.273" Checked="RadioButton_Checked"/>
        <RadioButton Grid.Column="2" Content="Comedy" HorizontalAlignment="Left" Margin="69,225,0,0" VerticalAlignment="Top"/>
        <RadioButton Grid.Column="2" Content="Science fiction" HorizontalAlignment="Left" Margin="170,245,0,0" VerticalAlignment="Top"/>
        <RadioButton Grid.Column="2" Content="Crime" HorizontalAlignment="Left" Margin="69,245,0,0" VerticalAlignment="Top"/>
        <RadioButton Grid.Column="2" Content="Romance" HorizontalAlignment="Left" Margin="170,225,0,0" VerticalAlignment="Top" Checked="RadioButton_Checked_2"/>
        <RadioButton Grid.Column="2" Content="Musical" HorizontalAlignment="Left" Margin="170,205,0,0" VerticalAlignment="Top" Checked="RadioButton_Checked_1"/>
        <RadioButton Grid.Column="2" Content="History" HorizontalAlignment="Left" Margin="170,183,0,0" VerticalAlignment="Top"/>
        <RadioButton Grid.Column="2" Content="Dokumentar" HorizontalAlignment="Left" Margin="69,265,0,0" VerticalAlignment="Top" Checked="RadioButton_Checked"/>
        <RadioButton Grid.Column="2" Content="Drama" HorizontalAlignment="Left" Margin="69,287,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.563,2.273"/>
        <RadioButton Grid.Column="2" Content="Fantasy" HorizontalAlignment="Left" Margin="69,307,0,0" VerticalAlignment="Top" Checked="RadioButton_Checked"/>
        <RadioButton Grid.Column="2" Content="Horror" HorizontalAlignment="Left" Margin="170,307,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.861,0.598"/>
        <RadioButton Grid.Column="2" Content="Western" HorizontalAlignment="Left" Margin="170,287,0,0" VerticalAlignment="Top"/>
        <RadioButton Grid.Column="2" Content="Thriller" HorizontalAlignment="Left" Margin="170,265,0,0" VerticalAlignment="Top"/>
        <Button Grid.Column="2" Content="Tilføj" HorizontalAlignment="Left" Margin="94,330,0,0" VerticalAlignment="Top" Height="34" Width="117" Click="Button_Click"/>
        <Button Grid.Column="2" Content="Slet " HorizontalAlignment="Left" Margin="408,330,0,0" VerticalAlignment="Top" Height="33" Width="117"/>

    </Grid>
</Window>
